# Frontend environment variables (must be prefixed with VITE_ to be accessible in the browser)
# See: https://vite.dev/guide/env-and-mode
#
# Production API base URL — used by api.js to point all fetch calls at the API subdomain.
# Leave empty (or omit) in development; the Vite dev-server proxy handles /api/* locally.
VITE_API_URL=https://api.nilainnresidency.com

