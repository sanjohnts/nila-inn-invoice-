PORT=3000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=nila_invoice
JWT_SECRET=replace_with_a_long_random_string_at_least_64_characters
NODE_ENV=production
CLIENT_URL=https://yourdomain.com

# Signup control (set to false in production)
ALLOW_SIGNUP=false

# Default Seed Credentials (change ADMIN_PASSWORD to a strong value)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@nilainn.com
ADMIN_PASSWORD=replace_with_strong_password
